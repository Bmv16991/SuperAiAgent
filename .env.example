# SuperAiAgent — Environment Variables
# Copy this file to .env and fill in your keys

# ── API Server ─────────────────────────────────────────────────────────────────
HERMES_API_KEY=your-secret-key-here
HERMES_API_PORT=8765

# ── Qdrant Vector DB ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave QDRANT_URL empty to use local file mode (not recommended for production)

# ── LLM Providers (add keys for tiers you want) ────────────────────────────────
DEEPSEEK_API_KEY=         # flash tier — cheapest, ~$0.003/1M cached tokens
OPENROUTER_API_KEY=       # plus / max / opus tiers (Qwen + Claude)
GROQ_API_KEY=             # free emergency fallback
CF_API_TOKEN=             # Cloudflare Workers AI — free fallback
CF_ACCOUNT_ID=            # your Cloudflare account ID
GEMINI_API_KEY=           # optional additional fallback

# ── SentenceTransformers Cache ─────────────────────────────────────────────────
# Where to store downloaded embedding models (~500MB)
# HF_HOME=./data/st_cache
